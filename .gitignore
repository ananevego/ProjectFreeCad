# Python кэш
__pycache__/
*.pyc
*.pyo

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Временные файлы Office (открытые документы)
~$*.pptx
~$*.docx
~$*.xlsx

# Existing model stores are distributed separately; never recommit them.
/stl_files/
/step_files/

# Runtime reports contain machine-local paths.
/output/*.report.json

# Batch manifests/reports/cache contain local paths and generated libraries.
/output/batches/

# Portable component bundles contain copied existing meshes and runtime reports.
/output/components/
