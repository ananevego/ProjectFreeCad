/* ___________________
  |                   |
  |     FOOTPRINTS    |
  |___________________|
*/
include <det_CUBE.lib>
include <det_1X2HDR_100.lib>
include <det_RAD_248.lib>
include <det_TRANSISTOR.lib>
include <det_7X2HDR_100.lib>
include <det_button.lib>
include <det_DIP_8.lib>


/* ___________________
  |                   |
  |       PARTS       |
  |___________________|
*/
module Pcb_det (frozen)
{
  translate([frozen?-originX_det:0, frozen?-originY_det:0, 0])
  {
    if( is_undef(drw_det_1X2HDR_100) )
      Draw_det_1X2HDR_100();
    else if( drw_det_1X2HDR_100 )
      Draw_det_1X2HDR_100();
    if( is_undef(drw_det_RAD_248) )
      Draw_det_RAD_248();
    else if( drw_det_RAD_248 )
      Draw_det_RAD_248();
    if( is_undef(drw_det_TRANSISTOR) )
      Draw_det_TRANSISTOR();
    else if( drw_det_TRANSISTOR )
      Draw_det_TRANSISTOR();
    if( is_undef(drw_det_7X2HDR_100) )
      Draw_det_7X2HDR_100();
    else if( drw_det_7X2HDR_100 )
      Draw_det_7X2HDR_100();
    if( is_undef(drw_det_button) )
      Draw_det_button();
    else if( drw_det_button )
      Draw_det_button();
    if( is_undef(drw_det_DIP_8) )
      Draw_det_DIP_8();
    else if( drw_det_DIP_8 )
      Draw_det_DIP_8();
    if( is_undef(drw_board_outline) )
      Draw_BO_det();
    else if( drw_board_outline != 0 )
      Draw_BO_det();
  }
}


