(footprint "PadGeometry_Control"
  (descr "Synthetic exact pad reduction control; not an official library footprint")
  (pad "1" smd custom (at 1 2 90) (size 1 1) (layers "F.Cu" "F.Mask" "F.Paste")
    (options (anchor rect) (clearance outline))
    (primitives
      (gr_poly (pts (xy -1 -0.5) (xy 0 -0.5) (xy 0 0.5) (xy -1 0.5)) (width 0) (fill yes))
      (gr_poly (pts (xy 0 -0.5) (xy 1 -0.5) (xy 1 0.5) (xy 0 0.5)) (width 0) (fill yes))))
  (pad "2" thru_hole circle (at 4 0) (size 1.4 1.4) (drill oval 0.8 0.8) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole rect (at 6 0 180) (size 1.8 1.2) (drill 0.8 (offset 0 0)) (layers "*.Cu" "*.Mask"))
)
