(footprint "StrokePatterns_Control"
  (descr "Synthetic KiCad9 default stroke profile control; not an official library footprint")
  (fp_line (start 0 0) (end 6 0) (stroke (width 0.1) (type dash)) (layer "F.SilkS"))
  (fp_line (start 0 1) (end 6 1) (stroke (width 0.1) (type dot)) (layer "B.SilkS"))
  (fp_line (start 0 2) (end 6 2) (stroke (width 0.1) (type dash_dot)) (layer "F.SilkS"))
  (fp_line (start 6 3) (end 0 3) (stroke (width 0.1) (type dash_dot_dot)) (layer "B.SilkS"))
  (fp_rect (start 0 5) (end 2 6) (stroke (width 0.1) (type dash_dot)) (fill no) (layer "F.SilkS"))
  (fp_poly (pts (xy 0 8) (xy 3 8) (xy 3 12) (xy 0 8))
    (stroke (width 0.1) (type dot)) (fill no) (layer "B.SilkS"))
  (pad "1" smd rect (at -1 -1) (size 1 1) (layers "F.Cu" "F.Mask" "F.Paste"))
)
