(footprint "TechnicalContact_Control"
  (descr "Synthetic native carrier/contact validation control; no 3D reference")
  (pad "" smd rect (at -2 0) (size 1 1) (layers "F.Paste"))
  (pad "1" connect rect (at 2 0 90) (size 2 1) (layers "B.Cu" "B.Mask"))
  (fp_rect (start -3 -1) (end -1 1) (stroke (width 0.1) (type solid)) (fill no) (layer "F.SilkS"))
  (fp_rect (start 1 -1.5) (end 3 1.5) (stroke (width 0.1) (type solid)) (fill no) (layer "B.SilkS"))
)
